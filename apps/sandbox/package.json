{
  "name": "@debrief/sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "dev": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register --watch src/infra/main.ts",
    "start:infra": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/infra/main.ts",
    "start:mcp": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/mcp/main.ts"
  },
  "devDependencies": {
    "@debrief/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@debrief/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "fastify": "catalog:",
    "zod": "catalog:"
  }
}
