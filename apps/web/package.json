{
  "name": "@debrief/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --port ${WEB_PORT:-3000}",
    "build": "next build --webpack",
    "start": "next start --port ${WEB_PORT:-3000}",
