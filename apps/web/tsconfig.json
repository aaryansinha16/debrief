{
  "extends": "@debrief/config/tsconfig/browser.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src", "*.config.ts", "*.config.mjs", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
