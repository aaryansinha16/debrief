# postgres (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=debrief
POSTGRES_PORT=5432
APP_DB_USER=debrief_app
APP_DB_PASSWORD=debrief_app
DATABASE_URL=postgres://debrief_app:debrief_app@localhost:5432/debrief
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/debrief

# minio (docker compose)
MINIO_ROOT_USER=debrief
MINIO_ROOT_PASSWORD=debrief-local-only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=debrief

# signing (generate with: pnpm --filter @debrief/api keygen debrief.signing-key.json)
SIGNING_KEY_FILE=debrief.signing-key.json
# BLOB_MASTER_KEY (64 hex) is appended to .env by pnpm run setup; never share it

# rate limits per key per minute: ingest batches · reads · expensive calls (jobs, narration, key management)
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_READ_PER_MINUTE=1200
RATE_LIMIT_EXPENSIVE_PER_MINUTE=30

# services
API_PORT=4000
WEB_PORT=3000
VERIFY_PORT=5173
SANDBOX_PORT=4100

# web (server-side only; a tenant key from: pnpm --filter @debrief/api seed --tenant demo)
DEBRIEF_API_URL=http://localhost:4000
DEBRIEF_API_KEY=

# narration (opt-in: POST /v1/runs/:id/narrative answers 503 without a key; never used on the ingest or reconstruction path)
ANTHROPIC_API_KEY=
NARRATION_MODEL=claude-opus-5

# anchoring (ARCHITECTURE §7.6): none keeps checkpoints as they are; rfc3161 asks a timestamp authority to witness each one
ANCHOR_KIND=none
ANCHOR_TSA_URL=
